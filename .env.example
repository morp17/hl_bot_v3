# ============================================================
# Hyperliquid Production Bot v3.0 — Configuração via .env
# ============================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env real no repositório!
#
# NOTA: Sub-modelos usam prefixo com underscore.
# Ex: RISK_STOP_LOSS_PCT → cfg.risk.stop_loss_pct
#     NOTIFICATIONS_TELEGRAM_BOT_TOKEN → cfg.notifications.telegram_bot_token

# --- Credenciais Hyperliquid ---
HYPERLIQUID_PRIVATE_KEY=0x_sua_private_key_aqui
HYPERLIQUID_ACCOUNT_ADDRESS=0x_seu_endereco_aqui

# --- Modo de Operação ---
TESTNET=true

# --- Símbolos para Trading ---
SYMBOLS=BTC/USDC,ETH/USDC,SOL/USDC

# --- Estratégia Principal ---
STRATEGY=hybrid_regime

# --- Estratégias liberadas para operar (CSV) ---
# IMPORTANTE: mean_reversion, orderflow_delta, scalping_grid e
# funding_arbitrage NÃO estão habilitadas por padrão — os backtests
# incluídos no repositório mostraram win rate/expectância negativa
# ou insuficiente para essas estratégias no período amostrado, e
# funding_arbitrage depende de funding_rate real (ver correção
# indicators.py/exchanges/hyperliquid.py). Habilite apenas após
# validação walk-forward própria.
ENABLED_STRATEGIES=trend_follow,adaptive_trend,hybrid_regime

# --- Timeframe Padrão ---
TIMEFRAME=1h

# --- Capital e Risco (nível raiz) ---
CAPITAL_USD=1000
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=20.0
LEVERAGE=3
ISOLATED_MARGIN=true

# --- RiskConfig (prefixo RISK_) ---
RISK_MAX_OPEN_TRADES=3
RISK_MAX_DRAWDOWN_PCT=15.0
RISK_DAILY_LOSS_LIMIT_PCT=5.0
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_COOLDOWN_AFTER_LOSS_SEC=300
RISK_STOP_LOSS_PCT=2.0
RISK_TAKE_PROFIT_PCT=5.0
RISK_TRAILING_STOP=false
RISK_TRAILING_STOP_ACTIVATION_PCT=3.0
RISK_TRAILING_STOP_DISTANCE_PCT=0.5
RISK_MAX_EXPOSURE_PCT=80.0
RISK_TAKER_FEE=0.0005
RISK_CIRCUIT_BREAKER_LOSS_PCT=15.0
RISK_CIRCUIT_BREAKER_COOLDOWN_SEC=3600
RISK_MAX_SPREAD_PCT=0.5
RISK_MAX_FUNDING_RATE=0.1
# REMOVIDOS (não implementados em nenhum cálculo — ver auditoria item 4):
# RISK_MIN_EDGE_VS_COSTS_MULT, RISK_LIQUIDATION_SAFETY_BUFFER_PCT (mantido
# abaixo pois É usado em risk.py como constante, mas não como campo
# configurável ativo — revisar se necessário expor),
# RISK_CORRELATION_HEDGE_THRESHOLD, RISK_KELLY_FRACTION,
# RISK_ANTI_MARTINGALE_MULT, RISK_BTC_CRASH_FILTER_PCT
# --- DashboardConfig (prefixo DASHBOARD_) ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme

# --- NotificationConfig (prefixo NOTIFICATIONS_) ---
NOTIFICATIONS_TELEGRAM_BOT_TOKEN=
NOTIFICATIONS_TELEGRAM_CHAT_ID=
NOTIFICATIONS_DISCORD_WEBHOOK_URL=
NOTIFICATIONS_SMTP_HOST=
NOTIFICATIONS_SMTP_PORT=587
NOTIFICATIONS_SMTP_USER=
NOTIFICATIONS_SMTP_PASSWORD=
NOTIFICATIONS_EMAIL_FROM=
NOTIFICATIONS_EMAIL_TO=

# --- StakingConfig (prefixo STAKING_) ---
STAKING_ENABLED=false
STAKING_VALIDATOR_ADDRESS=
STAKING_STAKE_PCT=0
STAKING_VAULT_ADDRESS=
STAKING_VAULT_DEPOSIT_PCT=0
STAKING_AUTO_COMPOUND=true

# --- MonitoringConfig (prefixo MONITORING_) ---
MONITORING_PROMETHEUS_PORT=9090
MONITORING_HEALTH_CHECK_PORT=8081
MONITORING_LOG_LEVEL=INFO

# --- BacktestConfig (prefixo BACKTEST_) ---
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-12-31
BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_SLIPPAGE_PCT=0.05
# ^ Agora efetivamente usado no motor de simulação (antes era lido
# da config mas nunca aplicado — ver correção em backtest.py).
BACKTEST_WALK_FORWARD_WINDOWS=4
# ^ Usado por BacktestEngine.run_walk_forward() (novo método).
